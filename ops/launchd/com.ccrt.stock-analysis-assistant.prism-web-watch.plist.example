<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ccrt.stock-analysis-assistant.prism-web-watch</string>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string><![CDATA[
cd "__PROJECT_ROOT__"
mkdir -p logs/prism-web
exec .venv/bin/python tools/render_prism_web.py
    ]]></string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>__PROJECT_ROOT__/local_archive/forward_monitor</string>
  </array>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/prism-web/watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/prism-web/watch.err.log</string>
</dict>
</plist>
