<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Data-only schedule. It never renders, activates, or publishes a report. -->
  <key>Label</key>
  <string>com.ccrt.stock-analysis-assistant.research-data</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string><![CDATA[
cd "__PROJECT_ROOT__"
set -a
source .env.local >/dev/null 2>&1
set +a
export PROJECT_ROOT="$PWD"
hour="$(date +%H)"
case "$hour" in
  06|07|08|09|10|11) stage="next-morning" ;;
  12|13|14|15|16|17|18|19|20) stage="close" ;;
  21|22|23|00|01|02|03|04|05) stage="evening" ;;
  *) echo "unsupported research-data hour: $hour"; exit 2 ;;
esac
exec .venv/bin/python -m stock_analyzer data run-stage --stage "$stage" --data-date auto
    ]]></string>
  </array>

  <key>StartCalendarInterval</key>
  <!-- 08:00 next-morning; 18:30 close; 21:30 evening. -->
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/research-data/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/research-data/launchd.err.log</string>
</dict>
</plist>
