<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ stock_name }} 股票报告</title>
</head>
<body>
  <main>
    <h1>{{ stock_name }}</h1>
    {% if is_fixture %}
    <section role="alert">
      <h2>Fixture/sample report</h2>
      <p>{{ fixture_warning }}</p>
    </section>
    {% endif %}
    {% if stock_narrative %}
    <section data-narrative-marker="{{ stock_narrative.narrative_marker }}">
      <h2>当前结论</h2>
      <p>{{ stock_narrative.analysis_summary.text }}</p>
      <h2>明确动作与仓位</h2>
      <p>{{ stock_narrative.action|strategy_text }}；仓位 {{ stock_narrative.position_min_pct }}%-{{ stock_narrative.position_max_pct }}%</p>
      <h2>三条核心理由</h2>
      <ol>{% for reason in stock_narrative.core_reasons %}<li>{{ reason.text }}</li>{% endfor %}</ol>
      <h2>买入或继续观察的条件</h2>
      <ul>
        {% for line in stock_narrative.required_confirmation %}<li>{{ line|strategy_text }}</li>{% endfor %}
        {% for line in stock_narrative.observation_conditions %}<li>{{ line|strategy_text }}</li>{% endfor %}
      </ul>
      <h2>失效和退出条件</h2>
      <ul>
        {% for line in stock_narrative.invalidation_conditions %}<li>{{ line|strategy_text }}</li>{% endfor %}
        {% for line in stock_narrative.exit_conditions %}<li>{{ line|strategy_text }}</li>{% endfor %}
      </ul>
      <p>看错的主要风险：{{ stock_narrative.risk_if_wrong|strategy_text }}</p>
      {% if stock_narrative.five_day_progress %}
      <h2>重点股票五日进展</h2>
      <ul>{% for point in stock_narrative.five_day_progress %}<li>{{ point.text }}</li>{% endfor %}</ul>
      {% endif %}
    </section>
    {% else %}
    <p>{{ conclusion }}</p>
    {% endif %}

    <details class="audit-details">
      <summary>审计详情</summary>
    {% if strategy_v2_card %}
    <section>
      <h2>操作建议</h2>
      <p>{{ strategy_v2_card.action|strategy_text }}</p>
      <p>仓位：{{ strategy_v2_card.position_min_pct }}%-{{ strategy_v2_card.position_max_pct }}%</p>

      <h3>理由</h3>
      <ul>
        {% for line in strategy_v2_card.action_reasoning %}
        <li>{{ line|strategy_text }}</li>
        {% endfor %}
      </ul>

      <h3>确认条件</h3>
      <ul>
        {% for line in strategy_v2_card.required_confirmation %}
        <li>{{ line|strategy_text }}</li>
        {% endfor %}
      </ul>

      <h3>失效条件</h3>
      <ul>
        {% for line in strategy_v2_card.invalidation_conditions %}
        <li>{{ line|strategy_text }}</li>
        {% endfor %}
      </ul>

      <h3>分步计划</h3>
      <ul>
        {% for line in strategy_v2_card.staging_plan %}
        <li>{{ line|strategy_text }}</li>
        {% endfor %}
      </ul>

      <h3>看错风险</h3>
      <p>{{ strategy_v2_card.risk_if_wrong|strategy_text }}</p>
    </section>

    <section>
      <h2>六模块证据</h2>
      {% if strategy_v2_snapshot %}
      {% for module in strategy_v2_snapshot.modules %}
      <article>
        <h3>{{ strategy_module_labels.get(module.module.value, module.module.value) }}</h3>
        <p>{{ module.conclusion|strategy_text }}</p>

        {% if module.support %}
        <h4>支持</h4>
        <ul>
          {% for atom in module.support %}
          <li>{{ atom.headline|strategy_text }}</li>
          {% endfor %}
        </ul>
        {% endif %}

        {% if module.counter %}
        <h4>反证</h4>
        <ul>
          {% for atom in module.counter %}
          <li>{{ atom.headline|strategy_text }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </article>
      {% endfor %}
      {% else %}
      <p>未匹配到模块快照。</p>
      {% endif %}
    </section>
    {% else %}
    <section>
      <h2>发生了什么</h2>
      <p>{{ detail.what_happened }}</p>
    </section>

    <section>
      <h2>支撑证据</h2>
      <ul>
        {% for line in detail.evidence.support %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
    </section>

    <section>
      <h2>反证与风险</h2>
      <ul>
        {% for line in detail.evidence.counter_evidence %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
    </section>

    <section>
      <h2>确认信号</h2>
      <ul>
        {% for line in detail.evidence.confirmation_signals %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
    </section>

    <section>
      <h2>失效信号</h2>
      <ul>
        {% for line in detail.evidence.invalidation_signals %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
    </section>

    <section>
      <h2>观察计划</h2>
      <ul>
        {% for line in detail.observation_plan %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
    </section>

    <section>
      <h2>证据与规则引用</h2>
      <p>证据：{{ detail.evidence.evidence_id or "未记录" }}</p>
      <p>规则：{{ "；".join(detail.evidence.rule_references) or "未匹配规则" }}</p>
    </section>

    <section>
      <h2>数据可信度</h2>
      <p>{{ detail.evidence.data_credibility }}</p>
    </section>
    {% endif %}
    </details>
  </main>
</body>
</html>
